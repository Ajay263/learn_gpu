# Copy to .env (or run `make env` to generate one with random secrets).
# .env is git-ignored. Never commit real values.

# ── Environment profile: development | production
APP_ENV=development

# ── MinIO (object storage, system of record for media)
MINIO_ROOT_USER=minioadmin-change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_SFTPGO_ACCESS_KEY=svc-sftpgo
MINIO_SFTPGO_SECRET_KEY=change-me
MINIO_NIFI_ACCESS_KEY=svc-nifi
MINIO_NIFI_SECRET_KEY=change-me
MINIO_APP_ACCESS_KEY=svc-app
MINIO_APP_SECRET_KEY=change-me
S3_ENDPOINT_URL=http://localhost:9000

# ── SFTPGo (upload gateway)
SFTPGO_ADMIN_USER=sftpadmin
SFTPGO_ADMIN_PASSWORD=change-me
SFTPGO_UPLOADER_USER=newsdesk
SFTPGO_UPLOADER_PASSWORD=change-me
MAX_UPLOAD_BYTES=1073741824

# ── NiFi (single-user auth; password must be >= 12 chars)
NIFI_ADMIN_USER=nifiadmin
NIFI_ADMIN_PASSWORD=change-me-12chars
NIFI_SENSITIVE_PROPS_KEY=change-me-12chars

# ── Postgres (Pixeltable catalog, Keycloak, app state)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
PIXELTABLE_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me

# ── RabbitMQ (durable job queue)
RABBITMQ_USER=newsintel
RABBITMQ_PASSWORD=change-me

# ── Keycloak (OIDC)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ── AI inference (Kaggle tunnel in dev, internal URL in prod). Update with `make set-llm-url`.
AI_INFERENCE_BASE_URL=http://inference-fake:9100
AI_INFERENCE_API_KEY=change-me

# ── Internal service-to-service token (NiFi → API ingestion callback)
INGEST_SERVICE_TOKEN=change-me

# ── Fake inference gateway (dev/CI only): transcript lines returned for every audio chunk
FAKE_ASR_SCRIPT=/fixtures/asr-script.txt
